# Copy to .env (repo root) for native runs. Docker Compose sets its own values.
DATABASE_URL=postgresql+asyncpg://pulseledger:pulseledger@127.0.0.1:5432/pulseledger
# Restricted data-plane role. Created by the backend at boot; cannot bypass RLS.
APP_DATABASE_URL=postgresql+asyncpg://pulseledger_app:pulseledger_app@127.0.0.1:5432/pulseledger
REDIS_URL=redis://127.0.0.1:6379/0
# Optional today. Test-mode keys only: sk_test_... or rk_test_...
# A live key (sk_live_ / rk_live_) makes the backend refuse to start.
STRIPE_SECRET_KEY=
